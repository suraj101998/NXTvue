# Investment Matrix - Environment Variables
# Copy this file to .env and fill in your values

# ──────────────────────────────────────────────────────────────────────
# REQUIRED: LLM API Key for report generation (Bob)
# ──────────────────────────────────────────────────────────────────────
BOB_API_KEY=your-bob-api-key-here

# ──────────────────────────────────────────────────────────────────────
# OPTIONAL: External API Keys
# ──────────────────────────────────────────────────────────────────────
# FRED API for US Treasury yields, TIPS, inflation expectations
# Get free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key-here

# ──────────────────────────────────────────────────────────────────────
# OPTIONAL: Risk-Free Rates (used in Sharpe/Sortino calculations)
# ──────────────────────────────────────────────────────────────────────
# India: 10Y G-Sec yield approx (default 6.5%)
RISK_FREE_RATE_INDIA=0.065

# US: 10Y Treasury yield approx (default 5.0%)
RISK_FREE_RATE_US=0.05

# ──────────────────────────────────────────────────────────────────────
# OPTIONAL: Logging
# ──────────────────────────────────────────────────────────────────────
# Levels: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────────
# OPTIONAL: API Server (when running FastAPI)
# ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ──────────────────────────────────────────────────────────────────────
# OPTIONAL: Data Source Configuration
# ──────────────────────────────────────────────────────────────────────
# Enable/disable specific data sources
ENABLE_SCREENER=true
ENABLE_YFINANCE=true
ENABLE_MFTOOL=true
ENABLE_FRED=true

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL_SECONDS=3600

# ──────────────────────────────────────────────────────────────────────
# OPTIONAL: Report Generation
# ──────────────────────────────────────────────────────────────────────
# Projection year for forward-looking analysis
DEFAULT_PROJECTION_YEAR=2026

# PDF output directory (relative to project root)
REPORTS_DIR=reports

# ──────────────────────────────────────────────────────────────────────
# OPTIONAL: Feature Flags (for upcoming features)
# ──────────────────────────────────────────────────────────────────────
ENABLE_ETF_ANALYSIS=false
ENABLE_MF_ANALYSIS=false
ENABLE_BOND_ANALYSIS=false
ENABLE_PORTFOLIO_INTELLIGENCE=false