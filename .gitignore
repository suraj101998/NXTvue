!apps/frontend/**/assets/**/*.png
!apps/frontend/**/assets/**/*.jpg
!apps/frontend/**/public/**/*.png
!apps/frontend/**/public/**/*.jpg
!apps/frontend/**/public/**/*.jpeg
!docs/**/*.png
!docs/**/*.jpg

