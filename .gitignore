apps/backend/data/indmoney_tokens.json
# Cached portfolio data
apps/backend/data/portfolio.json
apps/backend/data/watchlist.json
apps/backend/data/analysis_history.json

# Generated PDF / analysis reports
apps/backend/reports/
/reports/

# ─── Holdings / Watchlist files ───────────────────────────────────────────────
# May contain personal financial data
holdings.xlsx
watchlist.txt
apps/backend/holdings.xlsx
apps/backend/watchlist.txt

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
